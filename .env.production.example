# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://pigeonarena.com

# Cloudflare Worker and D1 configuration used during production builds/deploys.
PIGEON_WORKER_NAME=pigeon-arena
PIGEON_D1_DATABASE_NAME=pigeon-waitlist
PIGEON_D1_DATABASE_ID=replace-with-your-cloudflare-d1-database-id
PIGEON_CUSTOM_DOMAIN=pigeonarena.com
PIGEON_WAITLIST_NOTIFY_TO=hello@pigeonarena.com
